# ---------------------------------------------------------------------------
# Copy to ../.env (repo root) or backend/.env and fill in.
# NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Which settings module: dev | test | prod
DJANGO_SETTINGS_MODULE_SHORT=dev

# ---------------------------------------------------------------- core
DJANGO_SECRET_KEY=change-me-to-50-plus-random-characters-before-going-near-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_JSON=True
# Mount the Swagger UI at /api/docs/ (never enable in prod)
DJANGO_SERVE_API_DOCS=True

# ---------------------------------------------------------------- postgres
DJANGO_DB_NAME=lawyer
DJANGO_DB_USER=lawyer_app
DJANGO_DB_PASSWORD=lawyer_app
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSLMODE=prefer
DJANGO_TEST_DB_NAME=lawyer_test

# ---------------------------------------------------------------- redis
DJANGO_CACHE_URL=redis://127.0.0.1:6379/0
DJANGO_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
DJANGO_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# true = run tasks inline (no worker needed). Set false when running a worker.
DJANGO_CELERY_TASK_ALWAYS_EAGER=True
DJANGO_CELERY_TASK_EAGER_PROPAGATES=True

# ---------------------------------------------------------------- email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
DJANGO_EMAIL_HOST=mailhog
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=False

# ---------------------------------------------------------------- security
# Exact browser origins allowed to call the API cross-origin, comma-separated.
# `django-cors-headers` is wired in `base.py` (app + middleware, before
# CommonMiddleware) and scoped to `/api/` so `/admin/` is never cross-origin.
# Never `*`: auth cookies are credentialed and the spec forbids `*` with
# credentials. `prod.py` refuses to start when this is empty.
# The default frontend origin is :8000, served same-origin through Next's
# `/api/v1` proxy, so no value is required for the default local setup.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
# Needed for CSRF on any origin that can send a cookie-authenticated unsafe
# request. Same-origin requests bypass this; keep the list in step with the
# CORS allowlist above.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000
# Local dev only. Production (config.settings.prod) must set this to True, or
# omit it: the setting defaults to True there and `check --deploy` fails.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_TLS=False
DJANGO_ACCESS_TOKEN_LIFETIME_MINUTES=15
DJANGO_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------- pagination
DJANGO_PAGINATION_PAGE_SIZE=20

# ---------------------------------------------------------------- throttling
DJANGO_THROTTLE_ANON_RATE=60/min
DJANGO_THROTTLE_USER_RATE=600/min
DJANGO_THROTTLE_OTP_REQUEST_RATE=5/hour
DJANGO_THROTTLE_OTP_VERIFY_RATE=20/hour
DJANGO_THROTTLE_LOGIN_RATE=5/15min
DJANGO_THROTTLE_BOOKING_RATE=10/min
DJANGO_THROTTLE_AVAILABILITY_RATE=120/min
DJANGO_THROTTLE_WEBHOOK_RATE=120/min
DJANGO_THROTTLE_PAYMENT_RATE=30/min

# ---------------------------------------------------------------- storage
DJANGO_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=
DJANGO_AWS_S3_REGION_NAME=ap-south-1
DJANGO_AWS_S3_ENDPOINT_URL=
DJANGO_AWS_QUERYSTRING_AUTH=False
DJANGO_AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------- domain defaults
# The practice served when a request carries no tenant of its own.
#
# Required for a single-tenant install reached on a bare domain (localhost, or
# `lawyer.example.com`). TenantMiddleware can only identify a practice from the
# host subdomain (`alice.lawyer.test`) or the `X-Tenant-Slug` header; with neither
# nor this setting it binds nothing, and every tenant-scoped endpoint degrades
# quietly: `GET /services/` answers 200 with zero rows and
# `POST /payments/create-order/` answers 500. Nothing else in the stack reports
# the misconfiguration.
#
# Must match the slug `scripts/seed_demo.py` creates - it falls back to this
# value, then to "demo", so leaving it unset but seeding gives you "demo".
# Leave it empty only when every request is addressed by subdomain.
DJANGO_DEFAULT_TENANT_SLUG=demo
DJANGO_DEFAULT_TIMEZONE=Asia/Kolkata
DJANGO_DEFAULT_CURRENCY=INR
DJANGO_SLOT_HOLD_MINUTES=10
DJANGO_CANCELLATION_POLICY_MIN_HOURS=0
# Unpaid holds a single customer may hold open at once (S §A7 hold abuse).
DJANGO_MAX_ACTIVE_HOLDS_PER_CUSTOMER=5
DJANGO_BOOKING_LEAD_TIME_HOURS=2
DJANGO_BOOKING_LOOKAHEAD_DAYS=60
DJANGO_AVAILABILITY_LEAD_TIME_MINUTES=0
DJANGO_AVAILABILITY_HORIZON_DAYS=60
DJANGO_AVAILABILITY_CACHE_SECONDS=60

# ------------------------------------------------------------ client OTP
# Code lifetime (minutes), guess cap per code, and the delivery channel.
# Only `console` exists in Phase 4 - it prints the code to stdout for local
# flows. `+91` is the country assumed for phone numbers typed without a `+`.
DJANGO_OTP_LIFETIME_MINUTES=5
DJANGO_OTP_MAX_ATTEMPTS=5
DJANGO_OTP_SMS_BACKEND=console
DJANGO_DEFAULT_COUNTRY_CODE=+91

# ---------------------------------------------------------------- payments
# Only `razorpay` is implemented. A stub gateway (e.g. cashfree) refuses to
# start when DEBUG is off.
DJANGO_PAYMENT_GATEWAY=razorpay
# test|live. Must match the mode of the Razorpay keys below; a capture is only
# applied to an order created under the same mode.
DJANGO_PAYMENT_MODE=test
# Open orders older than this many minutes are compared against the gateway by
# the hourly reconcile task.
DJANGO_PAYMENT_RECONCILE_MINUTES=30
# Server-side only. The publishable key id is returned to the client in the
# create-order response; the key secret and webhook secret never leave the server.
DJANGO_RAZORPAY_KEY_ID=
DJANGO_RAZORPAY_KEY_SECRET=
DJANGO_RAZORPAY_WEBHOOK_SECRET=
