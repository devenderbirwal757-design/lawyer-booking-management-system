# Copy to .env.local for development. Never commit real values.
# All NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# they must be set when the image is built, not only at runtime.

# ---- Required in production -------------------------------------------------

# Public site origin — metadata, OG images, sitemap, canonical URLs, robots.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public origin of the API, as the browser sees it. Must end in /api/v1.
#
# With the same-origin proxy (API_PROXY_TARGET below) this is the Next origin
# itself, so the browser makes a same-origin request, never a CORS preflight.
# Set it to the backend's own origin only when the API is deployed separately.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Server-only proxy target: where Next forwards /api/v1/* to reach Django.
# Not exposed to the browser. Ignored when the API is on its own public origin.
API_PROXY_TARGET=http://localhost:8001

# Publishable (client-safe) Razorpay key. Used by the booking wizard (Phase 3).
# The secret key lives in the backend only — never expose it here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only alias for NEXT_PUBLIC_API_URL. Takes precedence in lib/api/client.ts
# when the public var is unset. Keep it out of the client bundle.
API_URL=

# ---- CORS (only when the API is on its own origin) ----------------------------
# Django's allowlist (DJANGO_CORS_ALLOWED_ORIGINS) must list this exact origin.
# With the same-origin proxy in place the browser never issues a cross-origin
# request, so this only applies to a separately deployed API.
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:8000

# Port the container/server listens on.
PORT=3000

# ---- Error monitoring (optional; unset disables Sentry) ----------------------

# Browser DSN. Public by design — it only allows event submission.
NEXT_PUBLIC_SENTRY_DSN=

# Server DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
SENTRY_DSN=

# Deployment environment label shown in Sentry (production, staging, preview).
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Release identifier for source maps and error grouping. Use the git SHA in CI.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# Build-time only. CI uses this to upload source maps; never needed at runtime
# and never exposed to the client.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- Build-time only ---------------------------------------------------------

# Set to 1 to silence Next.js telemetry collection in CI and containers.
NEXT_TELEMETRY_DISABLED=1
